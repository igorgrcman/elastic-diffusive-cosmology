\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces \textbf  {Schematic of chiral mode profiles (not a fit).} The left-handed mode $f_L(\xi )$ is peaked at the boundary $\xi = 0$. The right-handed mode $f_R(\xi )$ is displaced to $\xi = \xi _0$ deep in the bulk. The overlap of $f_R$ with the boundary is exponentially suppressed. This illustrates why only left-handed fermions couple to boundary-localized gauge fields.}}{192}{figure.12.1}\protected@file@percent }
\newlabel{fig:ch9_overlap_schematic}{{12.1}{192}{\textbf {Schematic of chiral mode profiles (not a fit).} The left-handed mode $f_L(\xi )$ is peaked at the boundary $\xi = 0$. The right-handed mode $f_R(\xi )$ is displaced to $\xi = \xi _0$ deep in the bulk. The overlap of $f_R$ with the boundary is exponentially suppressed. This illustrates why only left-handed fermions couple to boundary-localized gauge fields}{figure.12.1}{}}
