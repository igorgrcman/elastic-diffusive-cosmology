\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces \textbf  {Geometric origin of the Fermi constant.} In EDC, the weak four-fermion interaction arises from integrating out a brane-layer mediator. The mass gap $m_\phi \sim 1/\delta $ and the localization of fermion modes combine to produce the small effective coupling $G_F$ \textcolor {calibratedColor}{\textbf  {[Dc]}}{}. This explains ``why weak is weak'' without requiring the Higgs mechanism as the fundamental explanation.}}{219}{figure.9.1}\protected@file@percent }
\newlabel{fig:ch11_mediator_integration}{{9.1}{219}{\textbf {Geometric origin of the Fermi constant.} In EDC, the weak four-fermion interaction arises from integrating out a brane-layer mediator. The mass gap $m_\phi \sim 1/\delta $ and the localization of fermion modes combine to produce the small effective coupling $G_F$ \tagDc {}. This explains ``why weak is weak'' without requiring the Higgs mechanism as the fundamental explanation}{figure.9.1}{}}
