\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces \textbf  {Mode overlap determines $G_F$ magnitude.} The 4D Fermi constant arises from integrating the fourth power of the left-handed mode profile over the extra dimension. For an exponential profile with decay constant $m_0$, the overlap integral is exactly $I_4 = m_0$. Counterintuitively, tighter localization (larger $m_0$) produces a \emph  {larger} $I_4$---this is because tighter modes have higher peak amplitude when normalized \textcolor {gray}{\textbf  {[M]}}{}.}}{221}{figure.9.2}\protected@file@percent }
\newlabel{fig:ch11_mode_overlap}{{9.2}{221}{\textbf {Mode overlap determines $G_F$ magnitude.} The 4D Fermi constant arises from integrating the fourth power of the left-handed mode profile over the extra dimension. For an exponential profile with decay constant $m_0$, the overlap integral is exactly $I_4 = m_0$. Counterintuitively, tighter localization (larger $m_0$) produces a \emph {larger} $I_4$---this is because tighter modes have higher peak amplitude when normalized \tagM {}}{figure.9.2}{}}
