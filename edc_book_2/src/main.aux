\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces \textbf  {Generation spacing determines CKM hierarchy.} In the EDC picture, quark generations are localized at different positions along the extra dimension. The CKM element $|V_{ij}|$ is determined by the overlap between up-type profile $i$ and down-type profile $j$. Large separations ($\Delta \xi \gg \kappa $) produce exponential suppression of off-diagonal elements, generating the Wolfenstein hierarchy $\lambda $, $\lambda ^2$, $\lambda ^3$ \textcolor {calibratedColor}{\textbf  {[Dc]}}{}.}}{196}{figure.8.1}\protected@file@percent }
\newlabel{fig:ch7_generation_spacing}{{8.1}{196}{\textbf {Generation spacing determines CKM hierarchy.} In the EDC picture, quark generations are localized at different positions along the extra dimension. The CKM element $|V_{ij}|$ is determined by the overlap between up-type profile $i$ and down-type profile $j$. Large separations ($\Delta \xi \gg \kappa $) produce exponential suppression of off-diagonal elements, generating the Wolfenstein hierarchy $\lambda $, $\lambda ^2$, $\lambda ^3$ \tagDc {}}{figure.8.1}{}}
